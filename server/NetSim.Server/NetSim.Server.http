@host = http://localhost:5184

### הרשמה
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "username": "lea",
  "email": "lea@example.com",
  "password": "Secret1!"
}

### התחברות
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "lea@example.com",
  "password": "Secret1!"
}
