<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetSim.UI.ViewModels"
             x:Class="NetSim.UI.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel">

  <ScrollViewer Padding="32">
    <StackPanel Spacing="{DynamicResource Space.LG}" MaxWidth="920" HorizontalAlignment="Left">

      <!-- Header -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Projects" Classes="H1" />
          <TextBlock Text="Create, open and manage your network simulation projects." Classes="BodySecondary" />
        </StackPanel>
        <Button Grid.Column="1"
                Content="New Project"
                Classes="Primary"
                Command="{Binding NewProjectCommand}"
                IsEnabled="{Binding !IsBusy}"
                VerticalAlignment="Top">
          <Button.Styles>
            <Style Selector="Button /template/ ContentPresenter">
              <Setter Property="Margin" Value="0" />
            </Style>
          </Button.Styles>
        </Button>
      </Grid>

      <!-- Toolbar: search + sort -->
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasProjects}">
        <TextBox Grid.Column="0"
                  Text="{Binding SearchText}"
                  PlaceholderText="Search projects..."
                  MaxWidth="320"
                  HorizontalAlignment="Left">
          <TextBox.InnerLeftContent>
            <PathIcon Data="{StaticResource Icon.Search}" Classes="SM" Margin="8,0,0,0" />
          </TextBox.InnerLeftContent>
        </TextBox>
        <ComboBox Grid.Column="1" SelectedIndex="{Binding SortModeIndex, Mode=TwoWay}" Width="180">
          <ComboBoxItem Content="Recently Modified" />
          <ComboBoxItem Content="Name (A-Z)" />
        </ComboBox>
      </Grid>

      <Border Classes="Notification Error"
              IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource Icon.Error}" Classes="SM Error" />
          <TextBlock Text="{Binding ErrorMessage}" Classes="Body" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
        <ProgressBar IsIndeterminate="True" Width="120" />
        <TextBlock Text="Loading..." Classes="Caption" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Empty state -->
      <Border Classes="Panel" Height="240" IsVisible="{Binding HasNoProjects}">
        <StackPanel Classes="EmptyState">
          <PathIcon Data="{StaticResource Icon.Projects}" />
          <TextBlock Text="No projects yet" Classes="EmptyStateTitle" />
          <TextBlock Text="Create your first network simulation project to get started."
                     Classes="EmptyStateDescription" />
          <Button Content="Create Project" Classes="Primary" Margin="0,8,0,0" Command="{Binding NewProjectCommand}" />
        </StackPanel>
      </Border>

      <!-- Project list -->
      <ItemsControl ItemsSource="{Binding Projects}" IsVisible="{Binding HasProjects}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="{DynamicResource Space.SM}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProjectListItem">
            <Border Classes="Card">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">

                <Ellipse Grid.Column="0"
                          Classes="StatusDot"
                          Classes.Success="{Binding IsCurrent}"
                          Classes.Neutral="{Binding !IsCurrent}"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" Classes="Subtitle" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <Border Classes="Badge Success" IsVisible="{Binding IsCurrent}">
                      <TextBlock Text="Active" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Description}" Classes="BodySecondary" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" />
                  <TextBlock Classes="Caption">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="Last modified {0:g} ֲ· Created {1:g}">
                        <Binding Path="LastModifiedAtUtc" />
                        <Binding Path="CreatedAtUtc" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Rename"
                        Classes="Tertiary"
                        Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).RenameProjectCommand}"
                        CommandParameter="{Binding}"
                        Margin="4,0" />

                <Button Grid.Column="3"
                        Classes="Icon"
                        ToolTip.Tip="Delete project"
                        Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).DeleteProjectCommand}"
                        CommandParameter="{Binding}"
                        Margin="4,0">
                  <PathIcon Data="{StaticResource Icon.Delete}" Classes="SM" />
                </Button>

                <Button Grid.Column="4"
                        Content="Open"
                        Classes="Primary"
                        Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).OpenProjectCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding !IsCurrent}" />

              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>

</UserControl>
