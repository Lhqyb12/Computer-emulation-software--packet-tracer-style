<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetSim.UI.ViewModels"
             x:Class="NetSim.UI.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="{DynamicResource Brush.Bg.App}">

  <Panel>

    <DockPanel>

      <!-- Menu -->
      <Menu DockPanel.Dock="Top" Background="{DynamicResource Brush.Bg.Panel}">
        <MenuItem Header="_File">
          <MenuItem Header="E_xit" Click="OnExitClicked" />
        </MenuItem>
      </Menu>

      <!-- Toolbar -->
      <Border Classes="Toolbar" DockPanel.Dock="Top">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Classes="Icon" Command="{Binding GoBackCommand}" ToolTip.Tip="Back">
            <PathIcon Data="{StaticResource Icon.ChevronLeft}" Classes="SM" />
          </Button>
          <Rectangle Classes="ToolbarSeparator" />
          <TextBlock Text="Network Simulator" Classes="Subtitle" VerticalAlignment="Center" Margin="8,0" />
        </StackPanel>
      </Border>

      <!-- Status bar -->
      <Border Classes="StatusBar" DockPanel.Dock="Bottom">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
            <Ellipse Classes="StatusDot Success" />
            <TextBlock Text="Ready" Classes="StatusText" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Sidebar -->
      <Border Classes="Sidebar" DockPanel.Dock="Left" Width="220">
        <StackPanel Spacing="4" Margin="12">

          <Button Classes="NavItem" Classes.Selected="{Binding IsHomeActive}" Command="{Binding NavigateHomeCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{StaticResource Icon.Home}" Classes="SM" />
              <TextBlock Text="Home" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

        </StackPanel>
      </Border>

      <!-- Content -->
      <Border Background="{DynamicResource Brush.Bg.Panel}">
        <ContentControl Content="{Binding CurrentViewModel}" />
      </Border>

    </DockPanel>

  </Panel>

</UserControl>
