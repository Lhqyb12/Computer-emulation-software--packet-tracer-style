<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetSim.UI.ViewModels"
             x:Class="NetSim.UI.Views.UnsavedChangesDialogView"
             x:DataType="vm:UnsavedChangesDialogViewModel">

  <StackPanel Spacing="16" Width="380">
    <TextBlock Text="Unsaved Changes" Classes="DialogTitle" />
    <TextBlock Text="{Binding Message}" Classes="BodySecondary" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Classes="Tertiary" Command="{Binding CancelCommand}" />
      <Button Content="Don't Save" Classes="Secondary" Command="{Binding DontSaveCommand}" />
      <Button Content="Save" Classes="Primary" Command="{Binding SaveCommand}" />
    </StackPanel>
  </StackPanel>

</UserControl>
