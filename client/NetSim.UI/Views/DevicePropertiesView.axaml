<!-- The Device Properties panel (step 9): opens on the right of the Network screen on a double-click on a device.
     Its DataContext is DevicePropertiesViewModel - every {Binding X} below reads / writes X in that view model.
     Taken from the reference project's DevicePropertiesView, cut down to steps 9-10 and given a title row with a close (X) button.
     xmlns = the "address books" this file uses: the first is Avalonia's own controls, "x" is XAML's own words,
     "vm" is our ViewModels folder. x:Class = the C# class this file belongs to (the code half, DevicePropertiesView.axaml.cs).
     x:DataType = the view model type, so the bindings are checked while building (a typo in a name fails the build) -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetSim.UI.ViewModels"
             x:Class="NetSim.UI.Views.DevicePropertiesView"
             x:DataType="vm:DevicePropertiesViewModel">

  <!-- The panel's frame: the same "Sidebar" look as the Device Library on the left, 300 units wide -->
  <Border Classes="Sidebar" Width="300">

    <!-- DockPanel = the title row sticks to the top; the last child (the scrolling content) fills the rest -->
    <DockPanel Margin="14">

      <!-- ===== Title row: the device's name on the left, the close (X) button on the right =====
           Grid with two columns: "*" = take all the room that is left, "Auto" = just as wide as the button -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <StackPanel Grid.Column="0" Spacing="2">
          <!-- The big title. Binding = shows DeviceName and updates by itself when it changes -->
          <TextBlock Text="{Binding DeviceName}" Classes="H2" TextWrapping="Wrap" />
          <!-- The device's kind under it, e.g. "Router" -->
          <TextBlock Text="{Binding DeviceTypeText}" Classes="BodySecondary" />
        </StackPanel>
        <!-- The X button: runs CloseCommand in the view model (CommunityToolkit made it from the Close() method) -->
        <Button Grid.Column="1" Classes="Icon" VerticalAlignment="Top" Command="{Binding CloseCommand}" ToolTip.Tip="Close">
          <PathIcon Data="{StaticResource Icon.Close}" Classes="SM" />
        </Button>
      </Grid>

      <!-- ===== The content - scrolls when the panel is taller than the window ===== -->
      <ScrollViewer>
        <!-- StackPanel = the sections one under the other, Space.MD (12 units) apart -->
        <StackPanel Spacing="{DynamicResource Space.MD}">

          <!-- ===== Section: GENERAL - the device's name ===== -->
          <TextBlock Text="GENERAL" Classes="Label" />
          <Border Classes="GroupContainer">
            <StackPanel Spacing="{DynamicResource Space.SM}">

              <TextBlock Text="Device Name" Classes="Label" />

              <!-- The name box. Mode=TwoWay = typing writes back into DeviceName in the view model.
                   Classes.Error = the box gets the red "Error" look while NameError has text.
                   StringConverters.IsNotNullOrEmpty turns "is there text?" into true / false -->
              <TextBox Text="{Binding DeviceName, Mode=TwoWay}" MaxLength="64"
                       Classes.Error="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <!-- Why the new name was refused - the red box, visible only while NameError has text -->
              <Border Classes="Notification Error"
                      IsVisible="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding NameError}" Classes="Body" TextWrapping="Wrap" />
              </Border>

              <!-- Apply: runs ApplyNameCommand (from the ApplyName() method) -->
              <Button Content="Apply" Classes="Primary" HorizontalAlignment="Right" Command="{Binding ApplyNameCommand}" />

            </StackPanel>
          </Border>

          <!-- ===== Section: IP SETTINGS (step 10) - the address, mask and gateway of one port =====
               IsVisible = CanConfigureIPv4: the whole section (title and box) is hidden for a switch, which has no IP addresses -->
          <TextBlock Text="IP SETTINGS" Classes="Label" IsVisible="{Binding CanConfigureIPv4}" />
          <Border Classes="GroupContainer" IsVisible="{Binding CanConfigureIPv4}">
            <StackPanel Spacing="{DynamicResource Space.SM}">

              <TextBlock Text="Port" Classes="Label" />

              <!-- The port list. ItemsSource = the choices (IPv4Ports - every port except Console, part 10.8).
                   SelectedItem TwoWay = picking a port writes it into SelectedPort -> OnSelectedPortChanged fills the boxes;
                   and when the view model changes SelectedPort (a reload), the list shows it.
                   HorizontalAlignment="Stretch" = as wide as the panel -->
              <ComboBox ItemsSource="{Binding IPv4Ports}" SelectedItem="{Binding SelectedPort, Mode=TwoWay}"
                        HorizontalAlignment="Stretch">
                <!-- How ONE choice looks: the port's full name, e.g. "FastEthernet0/1".
                     Inside the template, {Binding X} reads X of that line (DeviceInterfaceItem) -->
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="vm:DeviceInterfaceItem">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <!-- The three boxes. Mode=TwoWay = typing writes back into the view model's text.
                   PlaceholderText = the grey example shown while the box is empty; MaxLength="15" = the longest
                   address text is "255.255.255.255" - 15 characters -->
              <TextBlock Text="IP Address" Classes="Label" />
              <TextBox Text="{Binding AddressInput, Mode=TwoWay}" PlaceholderText="e.g. 192.168.1.10" MaxLength="15" />

              <TextBlock Text="Subnet Mask" Classes="Label" />
              <TextBox Text="{Binding SubnetMaskInput, Mode=TwoWay}" PlaceholderText="e.g. 255.255.255.0" MaxLength="15" />

              <!-- The gateway - label and box are shown only on end devices (UsesDefaultGateway, part 10.8) -->
              <TextBlock Text="Default Gateway" Classes="Label" IsVisible="{Binding UsesDefaultGateway}" />
              <TextBox Text="{Binding DefaultGatewayInput, Mode=TwoWay}" PlaceholderText="e.g. 192.168.1.1 (empty = none)"
                       MaxLength="15" IsVisible="{Binding UsesDefaultGateway}" />

              <!-- Why the IP settings were refused - the red box, visible only while AddressError has text (like NameError) -->
              <Border Classes="Notification Error"
                      IsVisible="{Binding AddressError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding AddressError}" Classes="Body" TextWrapping="Wrap" />
              </Border>

              <!-- The two buttons side by side on the right, 8 units apart.
                   Clear -> ClearIPv4Command (from ClearIPv4()); Apply -> ApplyIPv4Command (from ApplyIPv4()) - part 10.9 -->
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Clear" Classes="Secondary" Command="{Binding ClearIPv4Command}" />
                <Button Content="Apply" Classes="Primary" Command="{Binding ApplyIPv4Command}" />
              </StackPanel>

            </StackPanel>
          </Border>

          <!-- ===== Section: PORTS - one card per port ===== -->
          <TextBlock Text="PORTS" Classes="Label" />


          <!-- Step 11: why turning a port on / off was refused - the red box, visible only while PortError has text
               (the same look as the name and IP errors) -->
          <Border Classes="Notification Error"
                  IsVisible="{Binding PortError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding PortError}" Classes="Body" TextWrapping="Wrap" />
          </Border>

          <!-- ItemsControl = repeats the template below once for every line in Interfaces (DeviceInterfaceItem, part 9.1) -->
          <ItemsControl ItemsSource="{Binding Interfaces}">

            <!-- The lines one under the other, 6 units apart -->
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <!-- How ONE port looks. Inside the template, {Binding X} reads X of that line (DeviceInterfaceItem) -->
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:DeviceInterfaceItem">
                <Border Classes="GroupContainer">
                  <StackPanel Spacing="2">

                    <!-- First row: the short name in bold on the left, the status on the right -->
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding ShortName}" FontWeight="SemiBold" />
                      <!-- The status word: green while the port is up, red otherwise. Classes.X="{Binding ...}" = the class X
                           is on while the value is true. StatusText.Success / .Error are colors from Theme/Styles/StatusBar.axaml -->
                      <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                 Classes="StatusText" Classes.Success="{Binding IsUp}" Classes.Error="{Binding !IsUp}" />
                    </Grid>

                    <!-- The kind and the speed, e.g. "Fast Ethernet · 100 Mbps". StringFormat puts the two values into one text -->
                    <TextBlock Classes="Caption">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} · {1}">
                          <Binding Path="InterfaceTypeText" />
                          <Binding Path="SpeedText" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>

                    <!-- The physical (MAC) address. StringFormat adds the word "MAC" in front of the value -->
                    <TextBlock Text="{Binding MacAddressText, StringFormat='MAC {0}'}" Classes="Caption" />

                    <!-- Where its cable goes, e.g. "Switch0 Fa0/1", or "Not connected" -->
                    <TextBlock Text="{Binding ConnectedToText, StringFormat='Connected to: {0}'}" Classes="Caption" />

                    <!-- Step 10: the port's address and mask, e.g. "IP 192.168.1.10 / 255.255.255.0" ("IP - / -" when none).
                         The card's DataContext is the LINE, but "can this device have addresses?" belongs to the PANEL, so:
                         $parent[ItemsControl] = climb up to the ItemsControl that holds the cards; its DataContext is the panel's
                         view model; "(vm:DevicePropertiesViewModel)" = tell the compiler its type, so .CanConfigureIPv4 is checked -->
                    <TextBlock Classes="Caption"
                               IsVisible="{Binding $parent[ItemsControl].((vm:DevicePropertiesViewModel)DataContext).CanConfigureIPv4}">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="IP {0} / {1}">
                          <Binding Path="IPv4AddressText" />
                          <Binding Path="SubnetMaskText" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>

                    <!-- Step 10: the default gateway, e.g. "Gateway 192.168.1.1" - only on end devices (the same climb up) -->
                    <TextBlock Text="{Binding DefaultGatewayText, StringFormat='Gateway {0}'}" Classes="Caption"
                               IsVisible="{Binding $parent[ItemsControl].((vm:DevicePropertiesViewModel)DataContext).UsesDefaultGateway}" />


                    <!-- Step 11: the port's on / off button, at the bottom right of the card.
                         Content = its text from the line: "Turn off" or "Turn on" (ToggleText, part 11.5).
                         Command = the PANEL's TogglePortCommand - the card's DataContext is the line, so we climb up to the
                         ItemsControl and take its DataContext (the panel's view model), exactly like the IP rows above.
                         CommandParameter="{Binding}" = "{Binding}" with no name = the card's DataContext itself, i.e. THIS
                         port's line - it is handed to TogglePort(port), so the command knows which card was pressed -->
                    <Button Content="{Binding ToggleText}" Classes="Secondary" HorizontalAlignment="Right" Margin="0,4,0,0"
                            Command="{Binding $parent[ItemsControl].((vm:DevicePropertiesViewModel)DataContext).TogglePortCommand}"
                            CommandParameter="{Binding}" />

                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>

    </DockPanel>
  </Border>

</UserControl>
