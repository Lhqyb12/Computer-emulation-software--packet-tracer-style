<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetSim.UI.ViewModels"
             xmlns:views="using:NetSim.UI.Views"
             xmlns:controls="using:NetSim.UI.Controls"
             xmlns:canvas="using:NetSim.Application.Canvas"
             x:Class="NetSim.UI.Views.NetworkWorkspaceView"
             x:DataType="vm:NetworkWorkspaceViewModel">

  <!-- A Grid with one cell: both parts below sit in the same place, and only one of them is visible at a time -->
  <Grid>

    <!-- No project open: a friendly message instead of an empty workspace -->
    <!-- "!" = the opposite: visible when HasCurrentProject is false -->
    <Border IsVisible="{Binding !HasCurrentProject}">
      <StackPanel Classes="EmptyState">
        <PathIcon Data="{StaticResource Icon.Network}" />
        <TextBlock Text="No project is currently open" Classes="EmptyStateTitle" />
        <TextBlock Text="Open or create a project to start building your network."
                   Classes="EmptyStateDescription" />
        <!-- Calls GoToProjects in the view model (CommunityToolkit adds "Command" to the name) -->
        <Button Content="Go to Projects" Classes="Primary" Margin="0,8,0,0" Command="{Binding GoToProjectsCommand}" />
      </StackPanel>
    </Border>

    <!-- The workspace: visible only while a project is open -->
    <!-- DockPanel = side panels "stick" to an edge, and the last child fills what is left -->
    <DockPanel IsVisible="{Binding HasCurrentProject}">

      <!-- ===== The workspace toolbar (step 5), stuck to the top edge, across the whole width =====
           Each button calls a command of the Canvas view model (CommunityToolkit adds "Command" to the method name).
           ToggleButton = a button that stays "pressed" - IsChecked shows which tool / option is on.
           Mode=OneWay = the button only SHOWS the value; clicking runs the command, which changes the value -->
      <Border Classes="Toolbar" DockPanel.Dock="Top">
        <StackPanel Orientation="Horizontal" Spacing="4">

          <!-- The three tools: Select (step 4), Pan (step 5), Connect (step 6) -->
          <ToggleButton Classes="ToolbarButton" IsChecked="{Binding Canvas.IsSelectToolActive, Mode=OneWay}"
                        Command="{Binding Canvas.SelectToolCommand}" ToolTip.Tip="Select and move (drag on empty space to select an area)">
            <PathIcon Data="{StaticResource Icon.Cursor}" Classes="SM" />
          </ToggleButton>
          <ToggleButton Classes="ToolbarButton" IsChecked="{Binding Canvas.IsPanToolActive, Mode=OneWay}"
                        Command="{Binding Canvas.PanToolCommand}" ToolTip.Tip="Pan (or hold Space / the middle mouse button and drag)">
            <PathIcon Data="{StaticResource Icon.Pan}" Classes="SM" />
          </ToggleButton>
          <ToggleButton Classes="ToolbarButton" IsChecked="{Binding Canvas.IsConnectToolActive, Mode=OneWay}"
                        Command="{Binding Canvas.ConnectToolCommand}" ToolTip.Tip="Connect: click a device, then a second device">
            <PathIcon Data="{StaticResource Icon.Connection}" Classes="SM" />
          </ToggleButton>

          <!-- Step 7: which cable the Connect tool lays. Picking a line also turns the Connect tool on.
               ItemsSource = the lines; SelectedItem TwoWay = the pick goes back to the view model -->
          <ComboBox ItemsSource="{Binding Canvas.CableOptions}" SelectedItem="{Binding Canvas.SelectedCableOption, Mode=TwoWay}"
                    Width="190" VerticalAlignment="Center" ToolTip.Tip="Cable type">
            <!-- How one line looks: just its text -->
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:CableOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- A thin line between groups -->
          <Rectangle Classes="ToolbarSeparator" />

          <!-- Delete the selection (step 4) - grey and disabled while nothing is selected (CanExecute) -->
          <Button Classes="ToolbarButton" Command="{Binding Canvas.DeleteSelectionCommand}" ToolTip.Tip="Delete selected (Delete)">
            <PathIcon Data="{StaticResource Icon.Delete}" Classes="SM" />
          </Button>

          <Rectangle Classes="ToolbarSeparator" />

          <!-- Zoom out / the zoom in percent / zoom in (step 5) -->
          <Button Classes="ToolbarButton" Command="{Binding Canvas.ZoomOutCommand}" ToolTip.Tip="Zoom out">
            <PathIcon Data="{StaticResource Icon.ZoomOut}" Classes="SM" />
          </Button>
          <TextBlock Text="{Binding Canvas.ZoomPercentText}" Classes="Caption" VerticalAlignment="Center" Width="44" TextAlignment="Center" />
          <Button Classes="ToolbarButton" Command="{Binding Canvas.ZoomInCommand}" ToolTip.Tip="Zoom in (or use the mouse wheel)">
            <PathIcon Data="{StaticResource Icon.ZoomIn}" Classes="SM" />
          </Button>

          <Rectangle Classes="ToolbarSeparator" />

          <!-- Fit everything in view / back to the starting view -->
          <Button Classes="ToolbarButton" Command="{Binding Canvas.FitToViewCommand}" ToolTip.Tip="Fit to view">
            <PathIcon Data="{StaticResource Icon.FitToView}" Classes="SM" />
          </Button>
          <Button Classes="ToolbarButton" Command="{Binding Canvas.ResetViewCommand}" ToolTip.Tip="Reset view">
            <PathIcon Data="{StaticResource Icon.ViewReset}" Classes="SM" />
          </Button>

          <Rectangle Classes="ToolbarSeparator" />

          <!-- Show the grid / snap to it -->
          <ToggleButton Classes="ToolbarButton" IsChecked="{Binding Canvas.IsGridVisible, Mode=OneWay}"
                        Command="{Binding Canvas.ToggleGridCommand}" ToolTip.Tip="Show grid">
            <PathIcon Data="{StaticResource Icon.Grid}" Classes="SM" />
          </ToggleButton>
          <ToggleButton Classes="ToolbarButton" IsChecked="{Binding Canvas.IsSnapToGridEnabled, Mode=OneWay}"
                        Command="{Binding Canvas.ToggleSnapToGridCommand}" ToolTip.Tip="Snap to grid">
            <PathIcon Data="{StaticResource Icon.Snap}" Classes="SM" />
          </ToggleButton>

        </StackPanel>
      </Border>

      <!-- The Device Library, stuck to the left edge. DataContext = it reads from the DeviceLibrary view model -->
      <views:DeviceLibraryView DockPanel.Dock="Left" DataContext="{Binding DeviceLibrary}" />

      <!-- The middle area: the Network Canvas, with a few things floating above it.
           Panel = all the children sit in the same place, one above the other (the last is on top) -->
      <Panel>

        <!-- The canvas itself. ViewModel = the Canvas view model of this screen.
             The colors come from the theme with DynamicResource, so a dark / light switch reaches the canvas too -->
        <controls:NetworkCanvasControl ViewModel="{Binding Canvas}"
                                       CanvasBackground="{DynamicResource Brush.Canvas.Background}"
                                       GridBrush="{DynamicResource Brush.Canvas.Grid}"
                                       ItemFillBrush="{DynamicResource Brush.Surface}"
                                       ItemBorderBrush="{DynamicResource Brush.Border.Strong}"
                                       ItemTextBrush="{DynamicResource Brush.Text.Primary}"
                                       AccentBrush="{DynamicResource Brush.Canvas.Selection}"
                                       HoverBrush="{DynamicResource Brush.Accent.Hover}"
                                       ConnectionBrush="{DynamicResource Brush.Canvas.Connection}" />

        <!-- Step 7: the "choose a port" list, opened under the clicked device.
             A Canvas panel lets us put it at an exact spot: Canvas.Left / Canvas.Top come from the view model
             (the device's corner through the camera, so it follows zoom and scroll).
             The Canvas itself lets the mouse through (no background), only the list catches clicks -->
        <Canvas IsVisible="{Binding Canvas.IsPortPickerOpen}">
          <Border Canvas.Left="{Binding Canvas.PortPickerLeft}" Canvas.Top="{Binding Canvas.PortPickerTop}"
                  Background="{DynamicResource Brush.Surface.Elevated}" BorderBrush="{DynamicResource Brush.Border.Strong}"
                  BorderThickness="1" CornerRadius="{DynamicResource Radius.MD}" Padding="6" MinWidth="220"
                  BoxShadow="{DynamicResource Shadow.MD}">
            <StackPanel Spacing="2">
              <!-- The title, e.g. "Switch0 - choose a port" -->
              <TextBlock Text="{Binding Canvas.PortPickerTitle}" Classes="Label" Margin="6,2,6,6" />

              <!-- One button per port. A greyed-out port can't take the chosen cable (its reason is shown) -->
              <ItemsControl ItemsSource="{Binding Canvas.PortPickerOptions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="canvas:PortOption">
                    <!-- $parent[UserControl] = reach the screen's own DataContext from inside the list, to call the command.
                         CommandParameter = which port was clicked (its full name) -->
                    <Button Classes="ToolbarButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            IsEnabled="{Binding IsSelectable}"
                            Command="{Binding $parent[UserControl].((vm:NetworkWorkspaceViewModel)DataContext).Canvas.ChoosePortCommand}"
                            CommandParameter="{Binding Name}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding ShortName}" FontWeight="SemiBold" MinWidth="64" />
                        <TextBlock Text="{Binding Status}" Classes="Caption" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Give up -->
              <Button Content="Cancel" Classes="ToolbarButton" HorizontalAlignment="Right" Margin="0,4,0,0"
                      Command="{Binding Canvas.CancelConnectionCommand}" />
            </StackPanel>
          </Border>
        </Canvas>

        <!-- A hint (not an error) at the top - e.g. the Connect tool's next step (step 6). Visible only when it has text -->
        <Border Classes="Notification Info" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0"
                IsHitTestVisible="False"
                IsVisible="{Binding Canvas.HintMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource Icon.Info}" Classes="SM" />
            <TextBlock Text="{Binding Canvas.HintMessage}" Classes="Body" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- The world point under the mouse, in the bottom-right corner (step 5).
             IsHitTestVisible="False" = the mouse goes through it to the canvas -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Padding="8,4"
                Background="{DynamicResource Brush.Bg.Panel}" BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="1" CornerRadius="{DynamicResource Radius.SM}" IsHitTestVisible="False">
          <TextBlock Text="{Binding Canvas.PointerCoordinatesText}" Classes="Caption" FontFamily="Consolas,monospace" />
        </Border>

        <!-- The hint, only while the canvas has no devices and nothing is being placed.
             IsHitTestVisible="False" = the mouse goes "through" it to the canvas below -->
        <StackPanel Classes="EmptyState" IsHitTestVisible="False" IsVisible="{Binding Canvas.ShowEmptyHint}">
          <PathIcon Data="{StaticResource Icon.Network}" />
          <TextBlock Text="Your network is empty" Classes="EmptyStateTitle" />
          <TextBlock Text="Pick a device in the Device Library and click here - or drag it onto the canvas."
                     Classes="EmptyStateDescription" />
        </StackPanel>

        <!-- An error (placing a device, or the Connect tool: e.g. "PC0 has no free port"), at the top of the canvas.
             Visible only when Canvas.ErrorMessage has text - the same red box the other screens use -->
        <Border Classes="Notification Error" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0"
                IsVisible="{Binding Canvas.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource Icon.Error}" Classes="SM Error" />
            <TextBlock Text="{Binding Canvas.ErrorMessage}" Classes="Body" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

      </Panel>

    </DockPanel>

  </Grid>

</UserControl>
