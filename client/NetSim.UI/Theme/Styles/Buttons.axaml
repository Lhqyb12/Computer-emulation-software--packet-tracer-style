<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Button variants: Primary, Secondary (the default look), Tertiary/Ghost, Destructive, Icon.
    Background/Foreground for pointerover/pressed/disabled are set against
    "/template/ ContentPresenter#PART_ContentPresenter" (FluentTheme's Button template part)
    because FluentTheme's own state styles target that same part - matching its selector shape
    is what lets our rules win once this file is included after <FluentTheme/> in App.axaml.
  -->

  <Style Selector="Button">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Default}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Medium}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.SM}" />
    <Setter Property="Height" Value="{DynamicResource Control.Height.MD}" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Border.Thickness.Hairline}" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
  </Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Border.Thickness.Emphasis}" />
  </Style>

  <!-- Secondary: same as the base outlined look, kept as an explicit class for intent -->
  <Style Selector="Button.Secondary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Border.Thickness.Hairline}" />
  </Style>

  <!-- Primary: solid accent fill, for the one primary action in a view -->
  <Style Selector="Button.Primary">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.Primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Button.Primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
  </Style>
  <Style Selector="Button.Primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Pressed}" />
  </Style>
  <Style Selector="Button.Primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
  </Style>

  <!-- Tertiary / Ghost: no border, transparent until interacted with -->
  <Style Selector="Button.Tertiary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.Tertiary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Destructive: solid error fill, for irreversible/dangerous actions -->
  <Style Selector="Button.Destructive">
    <Setter Property="Background" Value="{DynamicResource Brush.Error}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.Destructive /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Error}" />
  </Style>
  <Style Selector="Button.Destructive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Error.Hover}" />
  </Style>
  <Style Selector="Button.Destructive:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Error.Pressed}" />
  </Style>
  <Style Selector="Button.Destructive:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
  </Style>

  <!-- Icon-only: square, centered content, no chrome until interacted with -->
  <Style Selector="Button.Icon">
    <Setter Property="Width" Value="{DynamicResource Control.Height.MD}" />
    <Setter Property="Height" Value="{DynamicResource Control.Height.MD}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.Icon /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

</Styles>
