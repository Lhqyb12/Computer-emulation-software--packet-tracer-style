<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Sidebar chrome and navigation items. A nav item is a plain Button with Classes="NavItem";
    "Selected" is added/removed by binding Classes.Selected to a bool on the ViewModel (see
    MainWindow.axaml), so this stays generic enough for any future navigation entry without a
    dedicated NavItem control.
  -->

  <Style Selector="Border.Sidebar">
    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Sidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style Selector="Button.NavItem">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Height" Value="{DynamicResource Control.Height.LG}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.SM}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Medium}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.NavItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.NavItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
  </Style>
  <Style Selector="Button.NavItem.Selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
  </Style>
  <Style Selector="Button.NavItem.Selected">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Button.NavItem:disabled">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
  </Style>

  <!-- Optional badge (e.g. a count) attached to a nav item -->
  <Style Selector="Border.NavBadge">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Full}" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.NavBadge > TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.SemiBold}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

</Styles>
