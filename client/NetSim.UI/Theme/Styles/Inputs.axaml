<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    TextBox, ComboBox, CheckBox, RadioButton and ToggleButton. Resting-state colors/sizing are
    set directly on each control type (every Avalonia control template-binds these), while
    checked/accent visuals for CheckBox/RadioButton/ToggleSwitch come from the SystemAccentColor*
    override in Colors.axaml. TextBox additionally overrides its focus border directly, since
    that is the one state a network engineer's eye needs to catch immediately (which field has
    keyboard focus while filling in a device's config).
  -->

  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Default}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Border.Thickness.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.SM}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="{DynamicResource Control.Height.MD}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
  </Style>
  <!--
    FluentTheme's own ":focus" style sets PART_BorderElement's Background directly to its own
    (light) default resource, which wins over the plain "Background" setter above - that setter
    only feeds the TemplateBinding used in the unfocused state. Without repeating Background
    here, every text field would flash to FluentTheme's default color the moment it gains focus.
  -->
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
  </Style>
  <Style Selector="TextBox:disabled">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
  </Style>

  <!-- Visual-only validation state; no validation logic lives in this phase -->
  <Style Selector="TextBox.Error">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
  </Style>
  <Style Selector="TextBox.Error:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
  </Style>

  <!-- Monospace input variant: IP/MAC entry, hex, CLI-style fields -->
  <Style Selector="TextBox.Mono">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Mono}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Mono}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Default}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Border.Thickness.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.SM}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="MinHeight" Value="{DynamicResource Control.Height.MD}" />
  </Style>
  <Style Selector="ComboBox:disabled">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
  </Style>

  <Style Selector="CheckBox, RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Default}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="MinHeight" Value="{DynamicResource Control.Height.SM}" />
  </Style>
  <Style Selector="CheckBox:disabled, RadioButton:disabled">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
  </Style>

  <Style Selector="ToggleButton">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Default}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.SM}" />
    <Setter Property="Height" Value="{DynamicResource Control.Height.MD}" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Border.Thickness.Hairline}" />
  </Style>
  <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="ToggleButton:checked">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleButton:disabled">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
  </Style>

</Styles>
