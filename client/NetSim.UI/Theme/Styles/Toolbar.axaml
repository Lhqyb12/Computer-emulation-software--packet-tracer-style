<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Toolbar chrome, icon buttons, separators and a toggled "active tool" state. A dropdown
    toolbar action is just a ToolbarButton whose content is an icon plus a small chevron -
    no separate class needed for that composition.
  -->

  <Style Selector="Border.Toolbar">
    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8" />
  </Style>

  <Style Selector="Button.ToolbarButton, ToggleButton.ToolbarButton">
    <Setter Property="Width" Value="{DynamicResource Control.Height.SM}" />
    <Setter Property="Height" Value="{DynamicResource Control.Height.SM}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.SM}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.ToolbarButton /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.ToolbarButton /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.ToolbarButton:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.ToolbarButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
  </Style>
  <Style Selector="Button.ToolbarButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
  </Style>
  <Style Selector="Button.ToolbarButton:disabled PathIcon, ToggleButton.ToolbarButton:disabled PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
  </Style>

  <!-- Active tool: the currently-selected tool in a future toolbox (Select/Pan/Add/Connect/...) -->
  <Style Selector="ToggleButton.ToolbarButton:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
  </Style>
  <Style Selector="ToggleButton.ToolbarButton:checked PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>

  <Style Selector="Rectangle.ToolbarSeparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Fill" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="Margin" Value="4,4" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

</Styles>
