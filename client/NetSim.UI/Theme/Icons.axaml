<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Original, hand-authored icon glyphs on a 20x20 grid, used as PathIcon.Data.
    Not an external icon font/SVG library: Avalonia already ships everything needed to render
    vector glyphs (PathIcon + StreamGeometry), so adding a dependency (e.g. an icon-font
    package) would buy nothing but bundle weight and a licensing surface for something this
    small a set can cover directly. Every geometry below is an original union-of-primitives
    silhouette (rectangles/triangles/circles) using the NonZero fill rule ("F1" prefix), which
    keeps the whole set renderable as a single flat-fill color with no cutouts to get wrong.
    Sizing is applied by Styles/Icons.axaml via Classes, not by editing these paths.
  -->

  <StreamGeometry x:Key="Icon.Home">F1 M10,2 L2,9 H4 V18 H8 V13 H12 V18 H16 V9 H18 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Projects">F1 M2,5 H8 L10,7 H18 V17 H2 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Open">F1 M2,6 H8 L10,8 H19 L16,18 H2 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Settings">F1 M2,3.2 H18 V4.8 H2 Z M2,9.2 H18 V10.8 H2 Z M2,15.2 H18 V16.8 H2 Z M2.5,1.5 H6.5 V6.5 H2.5 Z M10.5,7.5 H14.5 V12.5 H10.5 Z M6.5,13.5 H10.5 V18.5 H6.5 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Menu">F1 M3,5 H17 V7 H3 Z M3,9.5 H17 V11.5 H3 Z M3,14 H17 V16 H3 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Close">F1 M4,5.4 L5.4,4 L10,8.6 L14.6,4 L16,5.4 L11.4,10 L16,14.6 L14.6,16 L10,11.4 L5.4,16 L4,14.6 L8.6,10 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.ChevronLeft">F1 M13,3 L6,10 L13,17 L15,15 L10,10 L15,5 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Add">F1 M9,3 H11 V9 H17 V11 H11 V17 H9 V11 H3 V9 H9 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Delete">F1 M4,6 H16 V17 H4 Z M3,4 H17 V6 H3 Z M8,2 H12 V4 H8 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Save">F1 M3,3 V17 H17 V5 L15,3 H11 V6 H7 V3 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Search">F1 M8,2 A6,6 0 1 0 8,14 A6,6 0 1 0 8,2 Z M12,13.3 L13.3,12 L18,16.7 L16.7,18 Z</StreamGeometry>

  <StreamGeometry x:Key="Icon.Router">F1 M3,9 H17 V16 H3 Z M5.3,2 H6.7 V9 H5.3 Z M9.3,1 H10.7 V9 H9.3 Z M13.3,2 H14.7 V9 H13.3 Z M14,11 H15.5 V12.5 H14 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Switch">F1 M2,6 H18 V14 H2 Z M3.5,14 H4.7 V16 H3.5 Z M8,14 H9.2 V16 H8 Z M10.8,14 H12 V16 H10.8 Z M15.3,14 H16.5 V16 H15.3 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Pc">F1 M4,3 H16 V13 H4 Z M9,13 H11 V15 H9 Z M6,15 H14 V16.5 H6 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Server">F1 M3,2 H17 V6 H3 Z M3,7.5 H17 V11.5 H3 Z M3,13 H17 V17 H3 Z M14,3.3 H15.5 V4.7 H14 Z M14,8.8 H15.5 V10.2 H14 Z M14,14.3 H15.5 V15.7 H14 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Laptop">F1 M4,3 H16 V12 H4 Z M2,13 L18,13 L16.4,16.5 L3.6,16.5 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Network">F1 M3,3 H7 V7 H3 Z M13,3 H17 V7 H13 Z M8,13 H12 V17 H8 Z M7,4.3 H13 V5.7 H7 Z M9.3,5.7 H10.7 V13 H9.3 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Connection">F1 M2,8 H6 V12 H2 Z M14,8 H18 V12 H14 Z M6,9.2 H14 V10.8 H6 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Packet">F1 M10,2 L18,10 L10,18 L2,10 Z</StreamGeometry>

  <StreamGeometry x:Key="Icon.Play">F1 M5,3 L17,10 L5,17 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Pause">F1 M5,3 H9 V17 H5 Z M11,3 H15 V17 H11 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Stop">F1 M4,4 H16 V16 H4 Z</StreamGeometry>

  <StreamGeometry x:Key="Icon.Ai">F1 M10,1 L12,8 L19,10 L12,12 L10,19 L8,12 L1,10 L8,8 Z</StreamGeometry>

  <!--
    Network Canvas toolbar. Icon.ZoomIn/Icon.ZoomOut/Icon.ViewReset use "F0" (EvenOdd) rather
    than the "F1" (NonZero) union-of-primitives style above, so the magnifier/target can have an
    actual ring/hole instead of a solid disc - the rest of the set (Cursor/Pan/FitToView/Grid)
    stays in the plain union style.
  -->
  <StreamGeometry x:Key="Icon.ZoomIn">F0 M8,2 A6,6 0 1 0 8,14 A6,6 0 1 0 8,2 Z M8,5 A3,3 0 1 0 8,11 A3,3 0 1 0 8,5 Z M7.3,5.5 H8.7 V7.3 H10.5 V8.7 H8.7 V10.5 H7.3 V8.7 H5.5 V7.3 H7.3 Z M12,13.3 L13.3,12 L18,16.7 L16.7,18 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.ZoomOut">F0 M8,2 A6,6 0 1 0 8,14 A6,6 0 1 0 8,2 Z M8,5 A3,3 0 1 0 8,11 A3,3 0 1 0 8,5 Z M5.5,7.4 H10.5 V8.6 H5.5 Z M12,13.3 L13.3,12 L18,16.7 L16.7,18 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Cursor">F1 M4,2 L4,17 L7.6,13.4 L10.2,18 L12.4,16.9 L9.7,12.2 L15,12.2 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Pan">F1 M9,5 H11 V15 H9 Z M5,9 H15 V11 H5 Z M8,5 L12,5 L10,1 Z M8,15 L12,15 L10,19 Z M5,8 L5,12 L1,10 Z M15,8 L15,12 L19,10 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.FitToView">F1 M2,2 L7,2 L7,3.4 L3.4,3.4 L3.4,7 L2,7 Z M18,2 L13,2 L13,3.4 L16.6,3.4 L16.6,7 L18,7 Z M2,18 L7,18 L7,16.6 L3.4,16.6 L3.4,13 L2,13 Z M18,18 L13,18 L13,16.6 L16.6,16.6 L16.6,13 L18,13 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.ViewReset">F0 M10,4 A6,6 0 1 0 10,16 A6,6 0 1 0 10,4 Z M10,5.5 A4.5,4.5 0 1 0 10,14.5 A4.5,4.5 0 1 0 10,5.5 Z M10,8.7 A1.3,1.3 0 1 0 10,11.3 A1.3,1.3 0 1 0 10,8.7 Z M9.3,0.5 H10.7 V3.2 H9.3 Z M9.3,16.8 H10.7 V19.5 H9.3 Z M16.8,9.3 H19.5 V10.7 H16.8 Z M0.5,9.3 H3.2 V10.7 H0.5 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Grid">F1 M6.7,2 H7.9 V18 H6.7 Z M12.1,2 H13.3 V18 H12.1 Z M2,6.7 H18 V7.9 H2 Z M2,12.1 H18 V13.3 H2 Z</StreamGeometry>
  <!-- Crosshair + filled center: "snap to grid" toggle, next to Icon.Grid on the canvas toolbar -->
  <StreamGeometry x:Key="Icon.Snap">F1 M9.3,1 H10.7 V5 H9.3 Z M9.3,15 H10.7 V19 H9.3 Z M1,9.3 H5 V10.7 H1 Z M15,9.3 H19 V10.7 H15 Z M8,8 H12 V12 H8 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Warning">F1 M10,2 L19,17 H1 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Error">F1 M5,2 H15 L18,5 V15 L15,18 H5 L2,15 V5 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Success">F1 M3,10 L8,15 L17,4 L15,2 L8,11 L5,8 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Info">F1 M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 Z</StreamGeometry>

</ResourceDictionary>
