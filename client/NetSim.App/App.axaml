<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NetSim.App"
             x:Class="NetSim.App.App"
             RequestedThemeVariant="Dark">

    <!-- Turn a ViewModel object into its matching View (see ViewLocator.cs). -->
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <!-- Base look for all standard controls. -->
        <FluentTheme />
        <!-- Our own colours and control styles, layered on top. -->
        <StyleInclude Source="avares://NetSim.App/Styles/Theme.axaml" />
    </Application.Styles>
</Application>
