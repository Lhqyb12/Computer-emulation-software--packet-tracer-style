<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetSim.App.ViewModels"
             x:Class="NetSim.App.Views.SignedInView"
             x:DataType="vm:SignedInViewModel">

    <StackPanel Spacing="14">
        <Border Background="{StaticResource OkBg}" CornerRadius="30" Width="60" Height="60"
                HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.CheckCircle}" Width="32" Height="32"
                      Foreground="{StaticResource Ok}" />
        </Border>

        <TextBlock Classes="title" HorizontalAlignment="Center" TextAlignment="Center"
                   Text="You're signed in" />
        <TextBlock Classes="subtitle" HorizontalAlignment="Center" TextAlignment="Center"
                   Text="The network simulator workspace isn't part of this preview build." />

        <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="label" Text="Signed in as" />
                <TextBlock FontSize="12.5" Foreground="{StaticResource Text}" Text="{Binding Email}" />
            </StackPanel>
        </Border>

        <Button Classes="ghost" Margin="0,4,0,0"
                Content="Sign out" Command="{Binding SignOutCommand}" />
    </StackPanel>
</UserControl>
