<!-- The "forgot my password" screen. It holds three panels in the same place and shows one at a time:
       step 1 = type your email, step 2 = type the code and a new password, step 3 = success.
     It is shown inside the card of MainWindow, and reads its data from ForgotPasswordViewModel.
     xmlns = the "dictionary" of Avalonia's own tags
     xmlns:x = the dictionary of the general XAML keywords (x:Class, x:DataType, x:Static)
     xmlns:vm = lets this file use our classes from the NetSim.App.ViewModels namespace
     xmlns:conv = Avalonia's ready-made converters (ObjectConverters.IsNotNull)
     x:Class = the C# class this file is the other half of (ForgotPasswordView.axaml.cs)
     x:DataType = the class the {Binding ...} expressions read from, so the compiler can check their names -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetSim.App.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="NetSim.App.Views.ForgotPasswordView"
             x:DataType="vm:ForgotPasswordViewModel">

    <!-- A Panel puts its children one on top of the other; IsVisible decides which of the three is seen -->
    <Panel>

        <!-- ================= STEP 1: ENTER EMAIL ================= -->
        <!-- Shown until a code was requested ("!IsCodeSent" = the opposite of IsCodeSent) -->
        <StackPanel Spacing="14" IsVisible="{Binding !IsCodeSent}">
                <!-- The round "back" arrow; a click returns to the sign-in screen -->
                <Button Classes="back" Command="{Binding GoToLoginCommand}" ToolTip.Tip="Back to sign in" />

            <!-- The title and a line of explanation under it -->
            <StackPanel Spacing="5">
                <TextBlock Classes="title" Text="Forgot your password?" />
                <TextBlock Classes="subtitle" Text="Enter your email and we'll send you a reset code." />
            </StackPanel>

            <!-- The red error box, shown only while the Error property is not null -->
            <Border Classes="banner bannerError"
                    IsVisible="{Binding Error, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <TextBlock Classes="error" Text="{Binding Error}" />
            </Border>

            <!-- The email box. The binding works both ways: every typed letter is written into Email -->
            <StackPanel Spacing="5">
                <TextBlock Classes="label" Text="Email" />
                <TextBox Classes="field" PlaceholderText="you@example.com" Text="{Binding Email}" />
            </StackPanel>

            <!-- The main button of step 1. IsDefault = pressing Enter clicks it.
                 Inside it, two contents share the same place: the normal text, and a dot with "Sending…"
                 while IsBusy is true -->
            <Button Classes="primary" IsDefault="True" Margin="0,2,0,0" Command="{Binding SendCodeCommand}">
                <Panel>
                    <TextBlock Text="Send reset code" IsVisible="{Binding !IsBusy}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding IsBusy}">
                        <Ellipse Classes="dot" VerticalAlignment="Center" />
                        <TextBlock Text="Sending…" />
                    </StackPanel>
                </Panel>
            </Button>

            <!-- The bottom line: a question and a link back to the sign-in screen -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                <TextBlock Classes="hint" Text="Remembered your password?" VerticalAlignment="Center" />
                <Button Classes="link" Content="Sign in" Command="{Binding GoToLoginCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- ================= STEP 2: ENTER CODE + NEW PASSWORD ================= -->
        <!-- Shown after a code was requested and until the password was replaced (ShowResetForm) -->
        <StackPanel Spacing="14" IsVisible="{Binding ShowResetForm}">
            <Button Classes="back" Command="{Binding GoToLoginCommand}" ToolTip.Tip="Back to sign in" />

            <!-- The title; the line under it shows the Status text ("If an account exists...") -->
            <StackPanel Spacing="5">
                <TextBlock Classes="title" Text="Check your email" />
                <TextBlock Classes="subtitle" Text="{Binding Status}" />
            </StackPanel>

            <!-- The red error box, shown only while there is an error -->
            <Border Classes="banner bannerError"
                    IsVisible="{Binding Error, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <TextBlock Classes="error" Text="{Binding Error}" />
            </Border>

            <!-- The box for the 6-digit code from the email -->
            <StackPanel Spacing="5">
                <TextBlock Classes="label" Text="Reset code" />
                <TextBox Classes="field" PlaceholderText="6-digit code" Text="{Binding Code}" />
            </StackPanel>

            <!-- The new password: a text box with an "eye" button on top of its right edge -->
            <StackPanel Spacing="5">
                <TextBlock Classes="label" Text="New password" />
                <Panel>
                    <!-- PasswordChar = the dot shown instead of every typed letter.
                         RevealPassword = show the real letters while IsPasswordVisible is true.
                         The right padding of 42 keeps the text from running under the eye button -->
                    <TextBox Classes="field"
                             PlaceholderText="Create a new password"
                             PasswordChar="●"
                             RevealPassword="{Binding IsPasswordVisible}"
                             Text="{Binding NewPassword}"
                             Padding="12,0,42,0" />
                    <!-- A ToggleButton stays pressed until it is clicked again; it switches IsPasswordVisible -->
                    <ToggleButton Classes="eye" HorizontalAlignment="Right" Margin="0,0,6,0"
                                  IsChecked="{Binding IsPasswordVisible}"
                                  ToolTip.Tip="Show or hide password" />
                </Panel>
            </StackPanel>

            <!-- The live requirements box: three rules that update while the user types.
                 Every rule line holds two icons in the same place - a green tick shown while the rule
                 is met and a grey circle shown while it is not - and next to them the text of the rule -->
            <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                <StackPanel Spacing="6">
                    <!-- Rule 1: at least 8 characters (HasMinLength) -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Panel Width="15" Height="15" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource Icon.CheckCircle}" Width="14" Height="14"
                                      Foreground="{StaticResource Ok}" IsVisible="{Binding HasMinLength}" />
                            <PathIcon Data="{StaticResource Icon.Circle}" Width="12" Height="12"
                                      Foreground="{StaticResource TextMuted}" IsVisible="{Binding !HasMinLength}" />
                        </Panel>
                        <TextBlock Text="At least 8 characters" FontSize="12"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Rule 2: contains a digit (HasNumber) -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Panel Width="15" Height="15" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource Icon.CheckCircle}" Width="14" Height="14"
                                      Foreground="{StaticResource Ok}" IsVisible="{Binding HasNumber}" />
                            <PathIcon Data="{StaticResource Icon.Circle}" Width="12" Height="12"
                                      Foreground="{StaticResource TextMuted}" IsVisible="{Binding !HasNumber}" />
                        </Panel>
                        <TextBlock Text="Contains a number" FontSize="12"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Rule 3: contains a special character (HasSpecial) -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Panel Width="15" Height="15" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource Icon.CheckCircle}" Width="14" Height="14"
                                      Foreground="{StaticResource Ok}" IsVisible="{Binding HasSpecial}" />
                            <PathIcon Data="{StaticResource Icon.Circle}" Width="12" Height="12"
                                      Foreground="{StaticResource TextMuted}" IsVisible="{Binding !HasSpecial}" />
                        </Panel>
                        <TextBlock Text="Contains a special character" FontSize="12"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The "confirm" box, bound to ConfirmPassword, and a red warning while the two boxes differ -->
            <StackPanel Spacing="5">
                <TextBlock Classes="label" Text="Confirm new password" />
                <Panel>
                    <TextBox Classes="field"
                             PlaceholderText="Repeat your new password"
                             PasswordChar="●"
                             RevealPassword="{Binding IsPasswordVisible}"
                             Text="{Binding ConfirmPassword}"
                             Padding="12,0,42,0" />
                    <ToggleButton Classes="eye" HorizontalAlignment="Right" Margin="0,0,6,0"
                                  IsChecked="{Binding IsPasswordVisible}"
                                  ToolTip.Tip="Show or hide password" />
                </Panel>
                <TextBlock Classes="error" Text="Passwords do not match" IsVisible="{Binding ShowPasswordMismatch}" />
            </StackPanel>

            <!-- The main button of step 2: the normal text, or a dot with "Resetting…" while IsBusy is true -->
            <Button Classes="primary" Margin="0,2,0,0" Command="{Binding ResetPasswordCommand}">
                <Panel>
                    <TextBlock Text="Reset password" IsVisible="{Binding !IsBusy}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding IsBusy}">
                        <Ellipse Classes="dot" VerticalAlignment="Center" />
                        <TextBlock Text="Resetting…" />
                    </StackPanel>
                </Panel>
            </Button>
        </StackPanel>

        <!-- ================= STEP 3: SUCCESS ================= -->
        <!-- Shown after the password was replaced (IsSuccess) -->
        <StackPanel Spacing="14" IsVisible="{Binding IsSuccess}">
            <!-- A 60x60 box with a corner radius of 30 = a circle, with a big green tick inside -->
            <Border Background="{StaticResource OkBg}" CornerRadius="30" Width="60" Height="60"
                    HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource Icon.CheckCircle}" Width="32" Height="32"
                          Foreground="{StaticResource Ok}" />
            </Border>
            <!-- The title and a sentence under it, both centred -->
            <TextBlock Classes="title" HorizontalAlignment="Center" TextAlignment="Center" Text="Password reset" />
            <TextBlock Classes="subtitle" HorizontalAlignment="Center" TextAlignment="Center"
                       Text="Your password has been changed. You can sign in now." />
            <!-- Returns to the sign-in screen -->
            <Button Classes="primary" Margin="0,4,0,0" Content="Continue to sign in" Command="{Binding GoToLoginCommand}" />
        </StackPanel>
    </Panel>
</UserControl>
